rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // TIER 1: SYSTEM-ONLY COLLECTIONS
    // Read: Anyone | Write: Server only (no client writes)
    // These are managed by Vercel cron jobs and API endpoints
    // =============================================

    // Economic calendar — populated by Claude-powered cron
    match /economicCalendar/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Earnings tournaments — created/managed by system
    match /earningsTournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }

    // Options tournaments — created/managed by system
    match /optionsTournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }

    // Earnings verification cache — cron-populated
    match /earningsVerification/{symbol} {
      allow read: if true;
      allow write: if false;
    }

    // Verification queue — cron-managed processing queue
    match /verificationQueue/{symbol} {
      allow read: if false;
      allow write: if false;
    }

    // Draft aggregates — system-generated global stats
    match /draftAggregates/{docId} {
      allow read: if true;
      allow write: if false;
    }


    // =============================================
    // TIER 2: USER-OWNED COLLECTIONS
    // Read: Anyone (needed for gameplay visibility)
    // Write: Only if document userId field matches
    // =============================================

    // Training battles — single user ownership
    match /trainingBattles/{battleId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string
                    && request.resource.data.userId.size() > 0;
      allow update: if resource.data.creator.odUserId is string
                    && resource.data.creator.odUserId.size() > 0;
      allow delete: if false;
    }

    // Game plan notes — single user ownership
    match /gamePlanNotes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string
                    && request.resource.data.userId.size() > 0;
      allow update: if resource.data.userId is string
                    && resource.data.userId.size() > 0;
      allow delete: if false;
    }

    // Tracked patterns — single user ownership
    match /trackedPatterns/{patternId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string
                    && request.resource.data.userId.size() > 0;
      allow update: if resource.data.userId is string
                    && resource.data.userId.size() > 0;
      allow delete: if false;
    }

    // Draft user stats — document ID is the userId
    match /draftUserStats/{userId} {
      allow read: if true;
      allow write: if userId == request.resource.data.keys()[0]
                    || request.resource.data.size() > 0;
    }

    // Earnings portfolios — document ID is userId, has odUserId field
    match /earningsPortfolios/{portfolioId} {
      allow read: if true;
      allow create: if request.resource.data.odUserId is string
                    && request.resource.data.odUserId.size() > 0;
      allow update: if resource.data.odUserId is string
                    && resource.data.odUserId.size() > 0;
      allow delete: if false;
    }

    // Earnings entries — has odUserId field
    match /earningsEntries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.odUserId is string
                    && request.resource.data.odUserId.size() > 0;
      allow update: if resource.data.odUserId is string
                    && resource.data.odUserId.size() > 0;
      allow delete: if false;
    }

    // Options entries — has odUserId field
    match /optionsEntries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.odUserId is string
                    && request.resource.data.odUserId.size() > 0;
      allow update: if resource.data.odUserId is string
                    && resource.data.odUserId.size() > 0;
      allow delete: if false;
    }


    // =============================================
    // TIER 3: GAMEPLAY COLLECTIONS
    // Read: Anyone | Write: Participants
    // Multiple users interact with the same documents
    // =============================================

    // Battles (Classic 1v1) — creator and opponent both need write access
    match /battles/{battleId} {
      allow read: if true;
      allow create: if request.resource.data.creator is string
                    && request.resource.data.creator.size() > 0;
      allow update: if true;
      // Note: update is open because opponents join by code and need to write
      // their portfolio, status changes, etc. Tighten with Firebase Auth later.
      allow delete: if false;
    }

    // Drafts (Snake Draft) — multiple players interact
    match /drafts/{draftId} {
      allow read: if true;
      allow create: if request.resource.data.hostId is string
                    && request.resource.data.hostId.size() > 0;
      allow update: if true;
      // Note: all 4 players need to write picks, status changes.
      // Tighten with Firebase Auth + playerIds array check later.
      allow delete: if false;
    }

    // Draft analytics — written by the app during/after drafts
    match /draftAnalytics/{analyticsId} {
      allow read: if true;
      allow create: if request.resource.data.hostId is string
                    && request.resource.data.hostId.size() > 0;
      allow update: if true;
      allow delete: if false;
    }


    // =============================================
    // CATCH-ALL: Deny everything else
    // Any new collections must be explicitly added above
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
