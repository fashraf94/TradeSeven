rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Composition write-epoch fence (client-SDK writer class; design note
    // docs/composition/PR2_RESOLVER_AND_EPOCH_DESIGN.md §3; Sol re-review
    // #1/#4). The §8 runbook drives composition/writeEpoch through its
    // states; ABSENT ⇒ open (fail-open: byte-identical behavior until the
    // runbook acts — pre-genesis, no token required). Once the doc EXISTS:
    //
    //   • state 'open'  → the write must carry `writeEpochId` EQUAL to the
    //     doc's epochId (#1 — the token is captured when the mutation is
    //     FORMED, so an E0-formed mutation submitted after E1 opens is
    //     DENIED at commit; a tokenless write denies too: the field access
    //     errors → false → deny, fail closed).
    //   • state 'probe' → additionally, request.auth.uid must be in the
    //     doc's probeIdentities (#4 — the 8B / Rollback-B verification
    //     windows admit ONLY the named operator probe identities; this is
    //     the client half of the server chokepoint's probe arm).
    //   • any other state ('closing'/'closed'/…) → DENIED.
    //
    // Server-evaluated at commit ⇒ genuine commit-time rejection for
    // client-SDK identity writers (rules/bundles authoring + agent births).
    // INERT UNTIL CONSOLE DEPLOY (G1 precedent). Cost: get() calls are
    // memoized per-evaluation — one epoch read per gated write.
    function epochDoc() {
      return get(/databases/$(database)/documents/composition/writeEpoch).data;
    }
    function epochWriteAdmitted() {
      return !exists(/databases/$(database)/documents/composition/writeEpoch)
             || (epochDoc().state == 'open'
                 && request.resource.data.writeEpochId == epochDoc().epochId)
             || (epochDoc().state == 'probe'
                 && request.auth.uid in epochDoc().probeIdentities
                 && request.resource.data.writeEpochId == epochDoc().epochId);
    }


    // ═══════════════════════════════════════════
    // TIER 1 — System Collections
    // Read: Authenticated users | Write: Server only (Admin SDK)
    // Managed by Vercel cron jobs and API endpoints
    // ═══════════════════════════════════════════

    // Composition activation record (PR 4, A24/A48): the ONE identity
    // selector. The client birth path reads it to seed the version the
    // record selects; every failure path (incl. this clause not yet
    // deployed) resolves to the LIVE identity — fail-safe. Server-only
    // writes (the activation service); the doc holds no secrets.
    match /composition/activation {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The write-epoch doc (PR 2 fence + Sol re-review #1): clients READ it to
    // capture the writeEpochId token when forming an identity mutation (and
    // the probe gate's identity list is not a secret). Never client-writable.
    match /composition/writeEpoch {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Economic calendar — LEGACY: the populating cron is retired and the
    // last content reader was removed (Phase 2 N4); api/health.js retains a
    // connectivity-probe read only. Rules kept while the collection exists.
    match /economicCalendar/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tournament collections: need client-side create for getOrCreate pattern
    // Cron handles resolution/status updates via Admin SDK (bypasses rules)
    match /earningsTournaments/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /optionsTournaments/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Earnings verification cache — cron-populated
    match /earningsVerification/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Market data cache — server-side API cache, populated by Admin SDK
    match /marketDataCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Verification queue — cron-managed processing queue
    match /verificationQueue/{doc} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════
    // Signal Drop (Phase 1)
    // Per-user drop records under users/{uid}/signalDrops/{dropId}.
    // Cache rows under signalDropCache/ — both the parse-cache
    // (doc id = contentHash) and expand-cache (doc id =
    // "expand:contentHash:YYYY-MM-DD") share this single block;
    // Firestore matches by collection path only, not by doc-id
    // shape, so the {contentHash} wildcard name is just a label.
    // Both writes go through Admin SDK only; client reads are
    // blocked entirely on the cache, allowed for the user's own
    // drop records.
    // ═══════════════════════════════════════════

    match /users/{userId}/signalDrops/{dropId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;  // Admin SDK only
    }

    match /signalDropCache/{contentHash} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // Draft aggregates — system-generated global stats
    match /draftAggregates/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // User Profiles
    // ═══════════════════════════════════════════

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════
    // TIER 2 — User-Owned Collections
    // Read: Authenticated users (needed for gameplay visibility)
    // Write: Owner verified via request.auth.uid
    // ═══════════════════════════════════════════

    // Training battles — single user ownership
    match /trainingBattles/{battleId} {
      allow read: if request.auth != null;
      // Accept EITHER top-level userId (string) OR creator object
      allow create: if request.auth != null
                    && (
                      (request.resource.data.userId is string
                       && request.resource.data.userId == request.auth.uid)
                      || (request.resource.data.creator is map
                           && request.resource.data.creator.odUserId == request.auth.uid)
                    );
      allow update: if request.auth != null;  // Beta: open updates for real-time battle state
      allow delete: if false;
    }

    // Game plan notes — single user ownership
    match /gamePlanNotes/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Game plan templates — single user ownership
    match /gamePlanTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Tracked patterns — single user ownership
    match /trackedPatterns/{patternId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // AGENT DASHBOARD — User-owned AI trading agents
    match /agents/{agentId} {
      allow read: if request.auth != null;
      // Create-side allowlist (Mastery end-of-branch ruling B1/B2, 2026-07-21
      // — the §7.2 hardening the 2026-07-15 discovery deferred): sensitive
      // fields are born at server defaults or not at all, so a crafted
      // client cannot mint entitlement/progression/cognition state at
      // creation, and recreate-laundering around the update allowlist below
      // is dead by construction. stats is the LEGACY FLOOR INPUT
      // (stats.gamesPlayed → FORGE_LIMITS tier → the §6.1 lazy legacy
      // floor) — forced to the exact createAgent zero shape, it is
      // server-only going forward (agent-evaluate increments it). The
      // absent-list fields are server-accreted only (equip/settings
      // endpoints, chat, cron); activeRules/equippedBundleIds/memory are
      // seeded empty by the live createAgent; consolidatedInsight ''; the
      // dev-only seedTestAgent (dead code, zero callers) seeded demo values
      // and is intentionally broken by this rule — flagged for separate
      // cleanup. Verified against every live client create path
      // (writer census 2026-07-21; docs/audits/2026-07-15_FIRESTORE_RULES_AGENTS_DISCOVERY.md).
      // ⚠ LOCKSTEP INVARIANT: the stats key set + zero values below mirror
      // the createAgent seed (agentService.js) exactly — any change to that
      // seed's stats shape MUST update this clause and the rules test in
      // the SAME change, or agent creation breaks in production. Per-key
      // numeric comparison (not map equality) so an SDK serializing zeros
      // as doubles still passes; hasOnly pins the key set.
      allow create: if request.auth != null
                    && epochWriteAdmitted()
                    && request.resource.data.ownerId == request.auth.uid
                    // Per-Battle Loadout Phase 1 (security review CONFIRMED-1/2):
                    // reserve the clone/system agent-id namespaces from CLIENT
                    // creates. Training + casual clones and CPU agents are all
                    // Admin-SDK-minted (bypass rules), so a client must NEVER create
                    // a doc at these ids — else it could squat a victim's
                    // casual-agent-{uid} (persistent DoS) or mint a casual clone with
                    // a poisoned cross-user rankedAgentId (learning poisoning). Real
                    // agents use random ids, so this denies only the attack.
                    && !agentId.matches('(casual-agent-|training-agent-|cpu-agent-).*')
                    && !request.resource.data.keys().hasAny(['standingLeans', 'dials', 'settingsRev',
                                 'equippedTraits', 'deployedStrategy', 'activeBattleId',
                                 'lessons', 'forgeSuggestions', 'isTrainingClone',
                                 'isCasualClone', 'rankedAgentId'])
                    && (!('stats' in request.resource.data)
                        || (request.resource.data.stats is map
                            && request.resource.data.stats.keys().hasOnly(['wins', 'losses', 'gamesPlayed',
                                 'totalScore', 'avgScore', 'currentStreak', 'bestStreak'])
                            && request.resource.data.stats.get('wins', 0) == 0
                            && request.resource.data.stats.get('losses', 0) == 0
                            && request.resource.data.stats.get('gamesPlayed', 0) == 0
                            && request.resource.data.stats.get('totalScore', 0) == 0
                            && request.resource.data.stats.get('avgScore', 0) == 0
                            && request.resource.data.stats.get('currentStreak', 0) == 0
                            && request.resource.data.stats.get('bestStreak', 0) == 0))
                    && (!('activeRules' in request.resource.data)
                        || (request.resource.data.activeRules is list
                            && request.resource.data.activeRules.size() == 0))
                    && (!('equippedBundleIds' in request.resource.data)
                        || (request.resource.data.equippedBundleIds is list
                            && request.resource.data.equippedBundleIds.size() == 0))
                    && (!('memory' in request.resource.data)
                        || (request.resource.data.memory is list
                            && request.resource.data.memory.size() == 0))
                    && (!('consolidatedInsight' in request.resource.data)
                        || request.resource.data.consolidatedInsight == '')
                    && (!('evolutionCycle' in request.resource.data)
                        || request.resource.data.evolutionCycle == 0)
                    // Q6 (hardening ruling): the equipped-watchlist trio is
                    // pinned at create. NOT force-null — the live onboarding
                    // (AgentCreationFlow) deliberately builds the starter
                    // watchlist first and seeds it in the SAME create write.
                    // The pin is ownership + type: a non-null id must name a
                    // watchlist doc the creator owns (watchlists are
                    // server-created with a userId owner field), so a
                    // crafted client cannot birth an agent pointed at
                    // another user's watchlist; name/timestamp are
                    // type-and-size-bounded.
                    && (!('equippedWatchlistId' in request.resource.data)
                        || request.resource.data.equippedWatchlistId == null
                        || (request.resource.data.equippedWatchlistId is string
                            && get(/databases/$(database)/documents/watchlists/$(request.resource.data.equippedWatchlistId)).data.userId == request.auth.uid))
                    && (!('equippedWatchlistName' in request.resource.data)
                        || request.resource.data.equippedWatchlistName == null
                        || (request.resource.data.equippedWatchlistName is string
                            && request.resource.data.equippedWatchlistName.size() <= 120))
                    && (!('equippedAt' in request.resource.data)
                        || request.resource.data.equippedAt == null
                        || request.resource.data.equippedAt is string);
      allow update: if request.auth != null
              && resource.data.ownerId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['directives', 'lastViewedEvolutionCycle', 'starterKitCompleted', 'updatedAt']);
      // Delete disposition (ruling B1/B2 left it to the build session, with
      // rationale): DENIED. The 2026-07-21 writer census found ZERO delete
      // paths — no client-SDK deleteDoc and no Admin-SDK delete targets an
      // agent doc anywhere — so this breaks nothing; an owner delete would
      // orphan the rules/bundles subtrees and any activeBattleId pointer;
      // and with create forced to server defaults, delete+recreate gains an
      // attacker nothing anyway. A real agent-deletion feature must ship as
      // a server endpoint that also settles subcollections and battles.
      // SECURITY POSTURE (Q8, founder-resolved): user-data erasure is
      // server-side by requirement — the Admin SDK bypasses this deny, so
      // the deny costs erasure nothing.
      allow delete: if false;

      // FORGE: Rules subcollection — soft-delete only, no hard deletes
      // Field-level validation for paramValues and textTemplate (Phase C security hardening)
      match /rules/{ruleId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow create, update: if request.auth != null
                    && epochWriteAdmitted()
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid
                    && (!('textTemplate' in request.resource.data)
                        || request.resource.data.textTemplate == null
                        || (request.resource.data.textTemplate is string
                            && request.resource.data.textTemplate.size() <= 500))
                    && (!('paramValues' in request.resource.data)
                        || request.resource.data.paramValues == null
                        || (request.resource.data.paramValues is map
                            && request.resource.data.paramValues.keys().size() <= 5))
                    && (!('status' in request.resource.data)
                        || request.resource.data.status == null
                        || request.resource.data.status in ['draft', 'testing', 'active', 'proven', 'queued'])
                    && (!('priority' in request.resource.data)
                        || request.resource.data.priority == null
                        || request.resource.data.priority is number)
                    && (!('traitId' in request.resource.data)
                        || request.resource.data.traitId == null
                        || request.resource.data.traitId is string)
                    && (!('provenance' in request.resource.data)
                        || request.resource.data.provenance == null
                        || request.resource.data.provenance in ['user_equipped', 'archetype_default']);
        allow delete: if false;
      }

      // FORGE: Bundles subcollection — no hard deletes (archive instead)
      match /bundles/{bundleId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        // Birth status vocabulary (Mastery end-of-branch ruling B3): a
        // client-created bundle is born 'draft' (forgeService.createBundle)
        // or 'forged' (the dimension materializer) — never 'equipped' or
        // 'archived'. Absent stays legal (defensive; no live path omits it).
        allow create: if request.auth != null
                    && epochWriteAdmitted()
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'version', 'previousVersionId', 'status', 'ruleIds', 'ruleSnapshots', 'conflictCheckResult', 'createdAt', 'forgedAt', 'equippedAt', 'archivedAt', 'updatedAt', 'performanceData', 'entrySource', 'hiddenFromBundleList', 'dimensionHash', 'dimensionValues', 'dimensionSchemaVersion', 'compileConfidence', 'compileTransparency', 'writeEpochId'])
                    && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'forged']);
        allow update: if request.auth != null
                    && epochWriteAdmitted()
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'version', 'previousVersionId', 'status', 'ruleIds', 'ruleSnapshots', 'conflictCheckResult', 'createdAt', 'forgedAt', 'equippedAt', 'archivedAt', 'updatedAt', 'performanceData', 'entrySource', 'hiddenFromBundleList', 'dimensionHash', 'dimensionValues', 'dimensionSchemaVersion', 'compileConfidence', 'compileTransparency', 'writeEpochId'])
                    // Status transition vocabulary (ruling B3): the ONLY
                    // status changes a client may perform are the live forge
                    // and archive gestures — draft→forged, draft→archived,
                    // forged→archived. Everything else is server-owned
                    // (equip/unequip/reforge endpoints, Admin SDK): never
                    // INTO 'equipped', never OUT of 'equipped' (the
                    // laundering hole: equipped→forged would unlock the
                    // content freeze below with the bundle still projected),
                    // never archived→anything, never →draft (reforge is the
                    // server path back to draft). [Deviation from the
                    // ruling's full "status server-write-only", documented:
                    // the LIVE client forge (draft→forged) and the
                    // born-'forged' dimension flow have no server
                    // equivalents; this closed vocabulary preserves them
                    // while making every equipped-adjacent transition
                    // server-only — the enforcement-consequential surface.]
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                        || (resource.data.status == 'draft' && request.resource.data.status in ['forged', 'archived'])
                        || (resource.data.status == 'forged' && request.resource.data.status == 'archived')
                        // Statusless backfill (extended to status:null by
                        // hardening ruling Q7): a doc born without status —
                        // or carrying an explicit null (legacy data; the
                        // census reports the null-status count) — may
                        // receive any non-equipped vocabulary value, else
                        // it is permanently stuck client-side.
                        || ((!('status' in resource.data) || resource.data.status == null)
                            && request.resource.data.status in ['draft', 'forged', 'archived']))
                    // Mastery P2 (§6.1 rider, review finding): an EQUIPPED
                    // bundle's rule CONTENT is immutable to clients — else a
                    // compliant bundle could pass the equip-time capacity
                    // check and be inflated afterwards, and every
                    // reprojection (gatherBundleSnapshots) would carry the
                    // inflated set into activeRules. 'name' joins the freeze
                    // per the Q8 consumer census (2026-07-21): it is read by
                    // the effective projection kernels (bundleName tag into
                    // activeRules) — display-consumed today, frozen because
                    // an effective path reads it. Dimension/telemetry
                    // fields on equipped docs stay writable (the
                    // persist-on-launch case). Server (Admin SDK) unaffected.
                    && (resource.data.status != 'equipped'
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ruleIds', 'ruleSnapshots', 'ruleHardness', 'name']));
        allow delete: if false;
      }

      // BATTLE PATTERNS — Server-only writes via Admin SDK, owner read
      match /battlePatterns/{patternId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // AGENT BATTLES — Server-managed collection with limited client writes.
    // Cron writes via Admin SDK (bypasses rules). Client can read own + update execution controls.
    match /agentBattles/{battleId} {
      allow read: if request.auth != null
                  && resource.data.ownerId == request.auth.uid;

      // Allow owner to update ONLY execution control fields
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['executionMode', 'pendingProposal', 'battleLedger', 'updatedAt', 'strategyPreset', 'gameplanMeeting', 'gameplanMeetingHistory', 'dailyGrades', 'feedBookmarks', 'reviewDecisions']);

      allow create, delete: if false;
    }

    // Draft user stats — document ID is the userId
    match /draftUserStats/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Earnings portfolios — has odUserId field
    match /earningsPortfolios/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.odUserId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.odUserId == request.auth.uid;
      allow delete: if false;
    }

    // Earnings entries — has odUserId field
    match /earningsEntries/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.odUserId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.odUserId == request.auth.uid;
      allow delete: if false;
    }

    // Options entries — has odUserId field
    // Create allows bot entries (odUserId starts with "bot_") from admin panel
    match /optionsEntries/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && (request.resource.data.odUserId == request.auth.uid
                        || request.resource.data.odUserId.matches('bot_.*'));
      allow update: if request.auth != null
                    && resource.data.odUserId == request.auth.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════
    // TIER 3 — Gameplay Collections
    // Read: Authenticated users | Write: Authenticated (multiplayer)
    // Multiple users interact with the same documents
    // ═══════════════════════════════════════════

    // Battles (Classic 1v1, BaggerBomb V2/V3/V4)
    match /battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Challenges (battle challenges between users)
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Drafts (Snake Draft) — multiple players interact
    match /drafts/{draftId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      // Claims subcollection — waiver wire claim-based free agency
      match /claims/{claimId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.odUserId == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.odUserId == request.auth.uid
                      && request.resource.data.status == "cancelled";
        allow delete: if false;
      }
    }

    // League Tournament groups — the drafts-sibling collection for the
    // per-group-of-four tournament game (Implementation Spec V1 §1.1,
    // docs/FANTASYTRADES_LEAGUE_TOURNAMENT_IMPLEMENTATION_SPEC_V1.md).
    // P0 scaffold posture: authenticated reads (spectator surfaces are
    // read-only by design), NO client writes — all mutation is Admin SDK
    // (claims cron branch, orchestrator) until P1 defines the client surface
    // (draft picks, flips, claims subcollection). Manual deploy via Firebase
    // Console required after merge — Firestore rules don't auto-deploy from
    // code; nothing reads this collection until P1, so no urgency.
    match /tournamentGroups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // P1a: tournamentGroups subcollections (boards/{odUserId}, streams/*;
    // picks/claims surfaces to come) — authenticated reads, never client
    // writes; all mutation stays Admin SDK. Matches subcollection documents
    // only, so the group-doc block above is unchanged. Same manual
    // Console-deploy caveat as above; inert until deployed.
    match /tournamentGroups/{groupId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // P3b: bracket-state docs (one per bracket; founder-ratified shape,
    // June 12, 2026) — the tournamentGroups pattern verbatim: authenticated
    // reads for the dev bracket card now and the P6/P7 spectator surfaces
    // later; all mutation stays Admin SDK (the Friday advancement + the dev
    // seeder). Same manual Console-deploy caveat; inert until deployed.
    match /tournamentBrackets/{bracketId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // P6a: the seasonal leaderboard (month-keyed docs, incl. the dev-
    // namespace — ruling A-4) and career-rank docs — the tournamentGroups
    // pattern verbatim: authenticated reads for the leaderboard/rank
    // surfaces; all mutation stays Admin SDK (the nightly aggregation
    // branch + the Friday advancement). Career rank deliberately does NOT
    // live on users/{uid} — that doc is owner-writable. Same manual
    // Console-deploy caveat as above; inert until deployed.
    match /tournamentLeaderboards/{monthId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tournamentRanks/{rankId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // P10: self-serve lobby waiting-pool docs — the front door before a group
    // exists (the tournamentGroups pattern verbatim: authenticated reads for
    // the "who's waiting" / own-lobby surface; all mutation is Admin SDK via
    // the authed lobby-* endpoints, never a client write). Includes the
    // reserved __cpuSequence allocator doc (server-only writer; a harmless
    // authenticated read). Same manual Console-deploy caveat as above; inert
    // until deployed and until LEAGUE_LOBBY_ENABLED flips.
    match /tournamentLobby/{lobbyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Snake Draft battles
    match /snakeDraftBattles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Snake Draft lobbies
    match /snakeDraftLobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Draft analytics — written by the app during/after drafts
    match /draftAnalytics/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════
    // Observability & Bug Reports
    // ═══════════════════════════════════════════

    // Error logs — written by ErrorBoundary on render crashes
    // Allow unauthenticated creates so pre-auth errors are captured.
    // Abuse protection: field count and message size limits.
    match /errorLogs/{logId} {
      allow read: if false;
      allow create: if request.resource.data.keys().size() <= 10
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow update, delete: if false;
    }

    // Bug Reports (ClashBot)
    match /bugReports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.userId is string
                    && request.resource.data.userId.size() > 0;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /bugReports/_counter {
      allow read, write: if request.auth != null;
    }

    // ═══════════════════════════════════════════
    // FantasyTimes — AI-generated newsroom stories
    // Public read, server-only writes (Admin SDK)
    // ═══════════════════════════════════════════

    match /fantasyTimesStories/{storyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // FantasyTimes deepdives — full Vera research markdown + structured
    // extraction records, written by /api/fantasytimes/ingest-deepdive
    // via Admin SDK. The summary lives in fantasyTimesStories; the full
    // content lives here.
    match /fantasyTimesDeepdives/{deepdiveId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════
    // FantasyTimes Wire — SERVER-ONLY (Wire Spec V1.5 §4.3)
    // Typed machine facts for agents. NEVER client-readable: the deny-all
    // catch-all already covers these (the masteryCorrections precedent),
    // but the blocks ship explicitly with the collections' own PR so the
    // posture is visible and the rules suite (test/rules/wireDenials)
    // asserts it against the emulator. Admin SDK bypasses rules.
    // ═══════════════════════════════════════════
    match /fantasyTimesWire/{marketDate} {
      allow read, write: if false;
    }
    match /fantasyTimesWireEnvelopes/{storyId} {
      allow read, write: if false;
    }
    match /wireMetrics/{marketDate} {
      allow read, write: if false;
    }
    match /wireEditorial/{isoWeek} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════
    // Index Intelligence & Stock Technical Scores
    // Public read, server-only writes (Admin SDK)
    // ═══════════════════════════════════════════

    match /indexIntelligence/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /stockTechnicalScores/{symbol} {
      allow read: if true;
      allow write: if false;
    }

    // Voice Layer Cache — authenticated read, server-only write (Admin SDK)
    match /voiceLayerCache/{battleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // League Agent Chat Budget — the per-(groupId, uid, dayN) question counter.
    // SERVER-ONLY on BOTH read and write (Admin SDK, api/agent/chat*.js): the
    // remaining count is server-authoritative and reaches the client ONLY through
    // the /api/agent/chat and /api/agent/chat-budget responses, never a direct read
    // (so it can never be computed or spoofed client-side).
    match /agentChatBudget/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // Discover — Thematic content for Discover tab
    // Authenticated read, server-only writes (Admin SDK via seed scripts)
    // Populated by scripts/seed-discover-themes.js and
    // scripts/seed-discover-sectors.js
    // ═══════════════════════════════════════════

    match /discoverThemes/{themeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /discoverSectors/{sectorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Discover engagement telemetry — user-write-only, server-read.
    // Each doc records a single tap (card open or Start-in-Workshop
    // click). Rule mirrors the gamePlanNotes user-create pattern but
    // forbids reads from clients (server-only via Admin SDK) and
    // forbids updates/deletes (immutable interaction log).
    match /discoverInteractions/{interactionId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Institutional holdings — public read, server-only write (Admin SDK)
    match /institutionalHoldings/{symbol} {
      allow read: if true;
      allow write: if false;
    }

    // Institutional aggregates — public read, server-only write (Admin SDK)
    match /institutionalAggregates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // FantasyTimes Consensus & Suppressions
    // Public read, server-only writes (Admin SDK)
    // ═══════════════════════════════════════════

    match /fantasyTimesConsensus/{date} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /validatedCatalysts/{date} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /fantasyTimesSuppressions/{date} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════
    // GAME DESIGN FEEDBACK (server-only)
    // ═══════════════════════════════════════════

    match /gameDesignFeedback/{docId} {
      allow read, write: if false;
    }

    match /gameDesignDigests/{docId} {
      allow read, write: if false;
    }

    match /gameDesignFeedbackArchive/{docId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════
    // SEASON MODE — Rules, Pit Stops, Leaderboard
    // Read: Owner (entries) / Authenticated (seasons, leaderboard)
    // Write: Server only, EXCEPT scoped client updates during open pit stop
    // ═══════════════════════════════════════════

    // Seasons — read-only for authenticated users; server manages lifecycle
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Season entries — owner read; shortlist writable only during open pit stop
    match /seasonEntries/{entryId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && resource.data.isPitStopOpen == true
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['seasonState.userShortlist', 'seasonState.shortlistWeek', 'updatedAt']);

      allow create, delete: if false;

      // Daily logs — owner read; server-only writes
      match /dailyLogs/{day} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/seasonEntries/$(entryId)).data.userId == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Pit stops — owner read; scoped client writes during open window only
      match /pitStops/{week} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/seasonEntries/$(entryId)).data.userId == request.auth.uid;

        allow update: if request.auth != null
                      && get(/databases/$(database)/documents/seasonEntries/$(entryId)).data.userId == request.auth.uid
                      && resource.data.status == 'open'
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['pendingUserMessage', 'shortlist', 'shortlistRationale', 'changes', 'changeCount', 'updatedAt']);

        allow create, delete: if false;
      }
    }

    // Season leaderboard — readable by any authenticated user (uses displayId, not raw UIDs)
    match /seasonLeaderboard/{seasonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Phase 4A: Deploy-to-Agent shadow log — client-side fallback for the
    // GCS training-data pipeline. Fire-and-forget writes from
    // deployStrategyService.logDeployEvent. Owner-scoped reads, owner-only
    // creates, immutable once written.
    match /deployEvents/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.agentId is string
                    && request.resource.data.experimentId is string;
      allow update, delete: if false;
    }

    // Phase 5: Workshop Mode — conversational strategy development sessions.
    // Owner-scoped reads; all writes go through the server (Admin SDK in
    // /api/forge/workshop-chat.js and /api/forge/compile-dimensions.js).
    match /workshopSessions/{sessionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Sprint 6 Phase 2: Signal Drop V2 watchlist dialogue sessions.
    // Mirrors the workshopSessions pattern: owner-scoped reads, all writes
    // through the server (Admin SDK in /api/forge/watchlist-dialogue.js
    // and the Phase 4 save endpoint). Manual deploy via Firebase Console
    // required after merge — Firestore rules don't auto-deploy from code.
    match /watchlistSessions/{sessionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Sprint 6 Phase 4A: persisted watchlists. Created by /api/forge/watchlists
    // (POST) when a dialogue finalizes; updated by PATCH/commit endpoints in
    // Phase 4B. Owner-scoped reads, server-only writes — same shape as the
    // watchlistSessions block above. Manual deploy via Firebase Console.
    match /watchlists/{watchlistId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Phase 5: Workshop Mode — compiled theses produced by
    // /api/forge/compile-dimensions.js. Immutable audit record of each
    // successful thesis → dimensions translation. Server-only writes.
    match /workshopTheses/{thesisId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Analysis sessions — owner-scoped reads, all writes through the server
    // (Admin SDK). Same shape as the watchlistSessions block above. Manual
    // deploy via Firebase Console required after merge — Firestore rules
    // don't auto-deploy from code.
    match /analysisSessions/{sessionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════
    // AGENT LEARNING SYSTEM — L1 Foundation (DARK-INERT)
    // Architecture V1.3 (FROZEN), T13: learning evidence is a
    // competitive-integrity surface. If a client could write it, a player
    // could manufacture a lesson and, through it, a leaderboard advantage.
    // So the DENIALS ship first — before any write path exists — and there
    // is never a window in which these collections are client-writable.
    //
    // ALL writes are server-side (Admin SDK via Vercel serverless), which
    // bypasses these rules entirely. The ONE client-readable surface is the
    // dossier, and only for its owning user, because the dossier is what
    // eventually surfaces to that user. Raw evidence atoms, receipts, and
    // calibration manifests are NEVER client-readable — they are the
    // substrate a lesson is derived from, and exposing them exposes other
    // agents' decision data.
    //
    // Manual deploy via Firebase Console required after merge — Firestore
    // rules don't auto-deploy from code; nothing writes or reads these
    // collections until Phase B (all behind LEARNING_L1_CAPTURE_ENABLED,
    // which is false at merge), so there is no urgency.
    // ═══════════════════════════════════════════

    // Dossier — the ONLY client-readable collection in the set, and only for
    // the owning user (resource.data.userId). No client writes, ever.
    match /learningDossiers/{agentId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow write: if false;  // Admin SDK only
    }

    // Evidence atoms — raw substrate a lesson is derived from. No client
    // reads (exposes other agents' decision data), no client writes.
    match /learningEvidence/{agentId}/atoms/{atomId} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // Receipts — the raw record of a decision opportunity, server-authoritative
    // evidence (T13). No client reads, no client writes.
    match /learningReceipts/{battleId}/receipts/{receiptId} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // Calibration manifest instances. No client reads, no client writes.
    match /learningCalibration/{manifestVersion} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // ═══════════════════════════════════════════
    // ARCHETYPE MASTERY (Spec V2 §5/§6; V2.1 memo
    // docs/ARCHETYPE_MASTERY_SPEC_V2_1_STOP_RULINGS_JUL21_2026.md)
    // Server-only collection pattern (career-rank precedent — user-doc XP is
    // forgeable, spec ruling B4/n17). All writes are Admin SDK settlement
    // transactions; NOTE: rules deploy is manual (npm run deploy:rules /
    // Firebase Console) — these blocks are inert until deployed.
    // ═══════════════════════════════════════════

    // Mastery profiles — owner-read, server-write (spec §6). The doc id IS
    // the userId; per-archetype {xp, level, battlesCounted, lastAwardAt}
    // live under archetypes.{archetypeId}.
    match /masteryProfiles/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false;  // Admin SDK only (award transaction)
    }

    // Epoch registry (append-only config doc) + any future mastery config.
    // No client reads (internals; the SURFACE flag reads profiles, not this).
    match /masteryConfig/{docId} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // Quarantine ledger — server-only diagnostics behind zero receipts
    // (spec §4: the public surface is the receipt's reasonCode enum ONLY;
    // the Film Room never renders internals). Its counts gate the §9
    // backfill go/no-go, so ONLY failed-to-award diagnostics live here.
    match /masteryQuarantine/{entryId} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // Audit ledger — server-only capture of award-adjacent audit events
    // (duplicate-rank pairs, spec §3) that route to the §8 corrections
    // intake. Separate from quarantine by design: audits accompany
    // SUCCESSFUL awards and must never inflate quarantine counts.
    match /masteryAudits/{entryId} {
      allow read: if false;   // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // masteryCorrections (spec §8) is deliberately ABSENT here: the
    // collection ships in a later phase and the catch-all below already
    // denies it; adding an explicit block rides that PR.

    // ═══════════════════════════════════════════
    // Default deny everything else
    // ═══════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
