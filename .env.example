# MarketClash Environment Variables
# Copy this file to .env and fill in your actual values

# =====================================================
# EXISTING API KEYS
# =====================================================

# Finnhub API (Stock prices)
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# =====================================================
# FIREBASE CONFIGURATION
# =====================================================
# Get these from Firebase Console > Project Settings > General
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# =====================================================
# NOTES
# =====================================================
# 1. Never commit the .env file to git (it's already in .gitignore)
# 2. All Vite env variables must start with VITE_
# 3. Restart dev server after changing env variables
