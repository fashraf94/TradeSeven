# FantasyTrades Environment Variables
# Copy this file to .env and fill in your actual values

# =====================================================
# SERVER-SIDE API KEYS (Vercel Environment Variables)
# =====================================================
# These keys are NEVER exposed to the browser.
# Add them in: Vercel Dashboard > Project > Settings > Environment Variables
#
# Required keys:
#   EODHD_API_KEY    - Market data (stocks, crypto, news)
#   CLAUDE_API_KEY   - AI Advisor (Anthropic Claude API)
#
# Get your keys from:
#   - EODHD: https://eodhd.com/
#   - Claude: https://console.anthropic.com/
#
# WARNING: Do NOT add VITE_ prefixed versions of these keys!
# Any VITE_ variable is bundled into the frontend and exposed publicly.

# =====================================================
# FIREBASE CONFIGURATION
# =====================================================
# Get these from Firebase Console > Project Settings > General
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# =====================================================
# FIREBASE ADMIN (Server-side)
# =====================================================
# For server-side Firebase operations (tournament resolution, etc.)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =====================================================
# CRON & ADMIN AUTHENTICATION
# =====================================================
# Used to secure cron endpoints and manual resolution triggers
# Generate a random string: openssl rand -hex 32

CRON_SECRET=your_random_secret_here
ADMIN_SECRET=your_admin_secret_here  # Falls back to CRON_SECRET if not set

# Bearer token for /api/fantasytimes/ingest-deepdive (Vera reporter intake).
# Vera's content is generated externally (Forge Agent on VPS) and posted to
# this endpoint manually via scripts/ingest-vera.js. Generate the same way
# as CRON_SECRET (openssl rand -hex 32). Required.
VERA_INGEST_SECRET=your_random_secret_here

# =====================================================
# NOTES
# =====================================================
# 1. Never commit the .env file to git (it's already in .gitignore)
# 2. All Vite env variables must start with VITE_
# 3. Restart dev server after changing env variables
# 4. Server-side only vars (no VITE_ prefix) go in Vercel Environment Variables
